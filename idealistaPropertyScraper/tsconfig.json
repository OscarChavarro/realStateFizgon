{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./src/main",
    "paths": {
      "src/*": [
        "*",
        "../../../modules/proxy/dist/*",
        "../../../modules/captchaSolvers/dist/*"
      ]
    },
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": ["src/main/**/*.ts", "src/main/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
