{
  "name": "scraper-idealista",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src/main --output-type err-long",
    "arch:graph": "depcruise --config .dependency-cruiser.cjs src/main --output-type dot | dot -T svg > doc/architecture/dependency-graph.svg",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "start": "node dist/main.js",
    "start:dev": "ts-node --files -r tsconfig-paths/register src/main/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.14",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.14",
    "@nestjs/platform-express": "11.1.14",
    "@real-state-fizgon/captcha-solvers": "file:../modules/captchaSolvers",
    "@real-state-fizgon/proxy": "file:../modules/proxy",
    "amqplib": "0.10.9",
    "chrome-remote-interface": "^0.33.3",
    "mongodb": "^6.12.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@types/amqplib": "^0.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^17.3.9",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "jest": "^30.2.0",
    "jest-util": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.56.1"
  }
}
